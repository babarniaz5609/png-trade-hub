# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration
# Optional: Can be configured for live remote Supabase PostgreSQL instance.
# If not provided, PNG Trade Hub operates seamlessly with high-fidelity local mock persistence.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
# Server-only: Never expose SERVICE_ROLE_KEY to frontend
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Tatum Blockchain API Integration (Server-Side Only)
# Future integration for USDT (TRC20, ERC20, BEP20), TRX, ETH, BNB
TATUM_API_KEY="your-tatum-api-key"
TATUM_TESTNET="true"
TATUM_WEBHOOK_SECRET="your-tatum-webhook-secret"

# Backend Authentication Secret
JWT_SECRET="png-trade-hub-secure-jwt-secret-demo"

